{
  "name": "@stefanhoth/dossier",
  "version": "0.0.0",
  "description": "Agent Event Log CLI – implements Agent Data Format Spec v2.0",
  "type": "module",
  "bin": { "dossier": "./bin/dossier.js" },
  "main": "./dist/cli.js",
  "files": ["dist", "bin", "schemas", "skills"],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "proper-lockfile": "^4.1.2",
    "uuid": "^11.0.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
